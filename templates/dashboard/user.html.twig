{% extends 'base.html.twig' %}

{% block title %}Hello DashboardController!{% endblock %}

{% block body %}

<style>
    h2 {
        padding-top: 100px;
    }

    body {
        background-color: darkgray;
    }
</style>
<div class="container">
    <h2 class="text-center">Mes membres</h2>
<a href="{{path('dashboard')}}">Retour</a>
    <a href="{{path('add_user')}}" class="btn mb-2 mb-md-0 btn-outline-secondary btn-block">Ajouter un membre</a>
    <table class="table table-hover mt-2">
        <thead class="table-dark">
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Prénom</th>
                <th scope="col">Nom</th>
                <th scope="col">Email</th>
                <th scope="col">Rôle</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
            <tr>
                <th>{{user.id}}</th>
                <td>{{user.firstname}}</td>
                <td>{{user.lastname}}</td>
                <td>{{user.email}}</td>
                <td>{{user.role}}</td>
                <td>
                    <a href="{{path('edit_user',{'id': user.id})}}"><i style="color: black;"
                            class="bi bi-pencil-square"></i></a> |
                    <a href="{{path('delete_user',{'id': user.id})}}"><i style="color: black;"
                            class="bi bi-trash"></i></a>
                </td>

            </tr>
            {% endfor %}
        </tbody>
    </table>

    </div>


    {% endblock %}