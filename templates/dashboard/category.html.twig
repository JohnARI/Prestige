{% extends 'base.html.twig' %}

{% block title %}Les catégories{% endblock %}

{% block body %}

<style>
    h2 {
        padding-top: 100px;
    }

    body {
        background-color: darkgray;
    }
</style>
<div class="container">

    <h2 class="text-center">Mes catégories</h2>
    <a href="{{path('dashboard')}}">Retour</a>
    <a href="{{path('add_category')}}" class="btn mb-2 mb-md-0 btn-outline-secondary btn-block">Ajouter une catégorie</a>
    <table class="table table-hover mt-2">
        <thead class="table-dark">
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Catégorie</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for category in categories %}
            <tr>
                <th>{{category.id}}</th>
                <td>{{category.sexe}}</td>
                
                <td>
                     <a href="{{path('edit_category',{'id': category.id})}}"><i style="color: black;" class="bi bi-pencil-square"></i></a> | 
                     <a href="{{path('delete_category',{'id': category.id})}}"><i style="color: black;" class="bi bi-trash"></i></a> 
                </td>

            </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>


    {% endblock %}