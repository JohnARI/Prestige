<style>
  @import url('https://fonts.googleapis.com/css2?family=Cinzel&display=swap');
  @import url('http://fonts.cdnfonts.com/css/gotham');
  @import url("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css");

.nav-link {
  color: white;
  text-transform: uppercase;
  position: relative;
}

nav {
  transition: 0.7s ease;
  font-family: 'Gotham', sans-serif;
}

.navbar {
  border-bottom: 1px rgba(255, 255,255,0.3) solid;
}

.nav-link:after {

  bottom: 0;
  content: "";
  height: 2px;
  left: 50%;
  position: absolute;
  background: #fff;
  transition: width 0.3s ease 0s, left 0.3s ease 0s;
  width: 0;
}

a:hover:after {
  width: 100%;
  left: 0;
}
</style>
  <nav class="navbar fixed-top navbar-expand-lg navbar">

    <div class="container">
      <div class="col-md-3 d-flex justify-content-center">
 <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link text-white" href="#">La marque</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white" href="#">Les montres</a>
          </li>
        </ul> 
       </div>
      <div class="collapse navbar-collapse d-flex justify-content-center col-md-6" id="navbarNav">
       
        <ul class="navbar-nav">
          <a class="navbar-brand" href="{{path('home')}}"><img class="navLogo" src="https://127.0.0.1:8000/assets/images/prestige_blanc.png" alt="Logo"></a>

        </ul>
       

      </div>

      {% if app.user %}
      <div class="col-md-3 d-flex justify-content-center">
        <div class="dropdown">
          <a type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle"></i>
          </a>
          <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
            <li><a class="dropdown-item" href="#">Mon compte</a></li>
            <li><a class="dropdown-item" href="{{path('app_logout')}}">Deconnexion</a></li>
          </ul>
        </div>
       </div>
      {% endif %}

      {% if not app.user %}
      <div class="col-md-3 d-flex justify-content-center">
       <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link text-white" href="{{path('register')}}">Inscription</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white" href="{{path('app_login')}}">Connexion</a>
          </li>
        </ul>
      </div>
      {% endif %}


    </div>
  </nav>


{% for message in app.flashes('success') %}
        <div class="alert alert-success text-center">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger text-center">
            {{ message }}
        </div>
    {% endfor %}





  <script>


    let nav = document.querySelector('nav');

    window.addEventListener('scroll', function () {
      if (window.pageYOffset > 100) {
        nav.classList.add('bg-black', 'shadow');

      } else {
        nav.classList.remove('bg-black', 'shadow');


      }
    });

    



  </script>