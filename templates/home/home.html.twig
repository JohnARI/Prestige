{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<style>
    a,
    a:hover {
        text-decoration: none;
        color: inherit;
    }

    .section-products {
        padding: 80px 0 54px;
    }

    .section-products .header {
        margin-bottom: 50px;
    }

    .section-products .single-product {
        margin-bottom: 26px;
        box-shadow: 1px 1px 12px #555;
    }

    .section-products .single-product .part-1 {
        position: relative;
        height: 290px;
        max-height: 290px;
        margin-bottom: 20px;
        overflow: hidden;
        box-shadow: 0 8px 6px -6px black;
    }

    .section-products .single-product .part-1::before {
        position: absolute;
        content: "";
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        transition: all 0.3s;
    }

  
    .section-products .single-product .part-1 .new {
        position: absolute;
        top: 15px;
        left: 20px;
        color: #ffffff;
        background-color: #fe302f;
        padding: 2px 8px;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    .section-products .single-product .part-1 .new {
        left: 0;
        background-color: #444444;
    }

    .section-products .single-product .part-1 ul {
        position: absolute;
        bottom: -41px;
        left: 20px;
        margin: 0;
        padding: 0;
        list-style: none;
        opacity: 0;
        transition: bottom 0.5s, opacity 0.5s;
    }

    .section-products .single-product:hover .part-1 ul {
        bottom: 30px;
        opacity: 1;
    }

    .section-products .single-product .part-1 ul li {
        display: inline-block;
        margin-right: 4px;
    }

    .section-products .single-product .part-1 ul li a {
        display: inline-block;
        width: 40px;
        height: 40px;
        line-height: 40px;
        background-color: #ffffff;
        color: black;
        text-align: center;
        box-shadow: 0 2px 20px rgb(50 50 50 / 10%);
        transition: color 0.2s;
    }

    .section-products .single-product .part-1 ul li a:hover {
    
        color: red;
    }

    .section-products .single-product .part-2 .product-title {
        font-size: 1rem;
    }

    .section-products .single-product .part-2 .product-color {
        font-size: 1rem;
    }

    .section-products .single-product .part-2 h4 {
        display: inline-block;
        font-size: 1rem;
    }

    .fs-2 {
  color: rgb(0, 0, 0);
  text-transform: uppercase;
  position: relative;
}

.fs-2:after {

bottom: 0;
content: "";
height: 2px;
left: 50%;
position: absolute;
background: rgb(0, 0, 0);
transition: width 0.3s ease 0s, left 0.3s ease 0s;
width: 0;
}

.fs-2:hover:after {
width: 100%;
left: 0;
}

.section-shop{
  padding-top: 100px;
  display: grid;
  grid-template-columns: 1fr 3fr;
}

.image-boutique{
    height: 800px;
}

.fs-3{
    color: rgb(0, 0, 0);
    text-transform: uppercase;
    position: relative;
}

</style>

<video class="modal-fullscreen" autoplay muted src="assets/images/watch_cover.mp4" type="video/mp4" loop=""
    preload="auto"></video>


    
    <div class="container">
        <section class="section-products">
            
            <div class="row">
                <div class="d-flex justify-content-center mt-5 mb-4">
               <h2 class="fs-2" href="">BEST SELLERS</h2>
            </div>  


                {% for product in products %}
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div id="product-1" class="single-product">
                        <div class="part-1 d-flex justify-content-center">

                            <img class="h-100 w-95" src="{{ asset('uploads/' ~ product.picture)}}" alt="">
                            <ul>
                                <li><a href="{{ path('addCart', {id: product.id, route : 'home'}) }}"><i class="fas fa-shopping-cart"></i></a></li>
                                <li><a href="#"><i class="fas fa-heart"></i></a></li>
                                <li><a href="{{ path( 'show_product', {'id' : product.id} ) }}"><i class="fas fa-expand"></i></a></li>
                            </ul>
                        </div>
                        <div class="part-2 ms-3 me-3">
                            <h3 class="product-title">{{product.name | length > 25 ? product.name | slice(0, 25) ~ '...' : product.name }}</h3>
                            <h4 class="product-price">{{product.price}} €</h4>
                        </div>
                    </div>
                </div>
                {% endfor %}

               



            </div> <!-- Fin row -->
        </section>

        <!-- Carousel -->
        <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
              <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
              <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
              <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
              <div class="carousel-item active">
                <img src="assets/images/montres_homme/montre_cartier_homme1.webp" class="d-block w-100" alt="Image carousel 1">
              </div>
              <div class="carousel-item">
                <img src="assets/images/montres_femme/montre_cartier_femme1.webp" class="d-block w-100" alt="Image carousel 2">
              </div>
              <div class="carousel-item">
                <img src="assets/images/montres_homme/montre_omega_homme3.jpg" class="d-block w-100" alt="Image carousel 3">
              </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
          </div>
          <!-- Fin carousel -->

 
</div> <!-- Fin container-->

     <section class="section-shop ms-4">

        <div class="adresse">
            <h3 class= "fs-2 text-center" href=""> BOUTIQUE PRESTIGE </h3>

            <p> Vous souhaitez nous rendre visite? Nous nous situons dans la ville de Paris, au 7 place Vendôme. Nous sommes impatients de vous accueillir aux horaires habituels au sein de notre boutique Prestige. </p>
<br>
<br>
            <h3 class= "fs-2 text-center" href="">SERVICE D’ENTRETIEN</h3>
            <p>Vous souhaitez faire réviser votre montre? Il vous suffit de la déposer dans notre boutique et nous en prendrons soin. </p>

        </div>

        <div class="image-boutique">
                <img src="assets/images/PrestigeBoutique.png" class=" h-100 w-100 ps-5" alt="Boutique Prestige">
        </div>
            </section>
        







{% endblock %}
