{% extends 'base.html.twig' %}

{% block title %}Adresse index{% endblock %}

{% block body %}
    <h1>Adresse index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Fullname</th>
                <th>Adresse</th>
                <th>ComplementAdresse</th>
                <th>Telehone</th>
                <th>Ville</th>
                <th>CodePostale</th>
                <th>Pays</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for adresse in adresses %}
            <tr>
                <td>{{ adresse.id }}</td>
                <td>{{ adresse.fullname }}</td>
                <td>{{ adresse.adresse }}</td>
                <td>{{ adresse.complementAdresse }}</td>
                <td>{{ adresse.telephone }}</td>
                <td>{{ adresse.ville }}</td>
                <td>{{ adresse.codePostale }}</td>
                <td>{{ adresse.pays }}</td>
                <td>
                    <a href="{{ path('adresse_show', {'id': adresse.id}) }}">Voir</a>
                    <a href="{{ path('adresse_edit', {'id': adresse.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('adresse_new') }}">Create new</a>
{% endblock %}
